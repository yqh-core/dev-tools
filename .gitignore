# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.DS_Store
dist
dist-ssr
# 换个名字构建（--outDir dist-xxx）是为了绕开 emptyOutDir 被拦截；这些同样是产物
dist-*
coverage
*.local

/cypress/videos/
/cypress/screenshots/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
/test-results/
/playwright-report/
/playwright/.cache/
# Webkit with playwright creates a salt file
salt
# vite 配置热重载时产生的临时文件
vite.config.ts.timestamp-*.mjs

# vue-tsc 增量编译缓存（composite 工程会自动产出，属构建产物）
*.tsbuildinfo

# wrangler 本地状态（`wrangler pages dev` 产出，含本地缓存，约 8MB）
.wrangler/
