# 安全响应头（CF Pages 消费，不对外提供）
/*
	Strict-Transport-Security: max-age=31536000; includeSubDomains
	X-Content-Type-Options: nosniff
	Referrer-Policy: strict-origin-when-cross-origin
	Permissions-Policy: geolocation=(), microphone=(), camera=(self)
	X-Frame-Options: SAMEORIGIN
	Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.googletagmanager.com https://static.cloudflareinsights.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.gstatic.com https://*.amplitude.com; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss: data: blob:; frame-src 'self' https:; worker-src 'self' blob:; media-src 'self' blob: https:; manifest-src 'self'

# Vite build assets use content hashes in their filenames, so they are safe to cache immutably.
# Keep this scoped to /assets/*; stable public files (service worker, consent script, icons)
# retain their existing revalidation policy.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The legacy archive is retained for existing visitors and redirects, but it is
# Chinese-only historical content and is outside the current English-first US/EU SEO scope.
# Keep crawling enabled so search engines can process this directive and follow links.
/legacy
  X-Robots-Tag: noindex, follow

/legacy/*
  X-Robots-Tag: noindex, follow
